# --- web/.env.example ---------------------------------------------------
# Client-exposed values (safe for the browser): NONE beyond demo hints.
# All service/gateway URLs are SERVER-SIDE ONLY (BFF route handlers read them).
# Tokens never reach browser JS — see web/AGENTS.md rule 3.

# Server-side base URL of the edge gateway (live mode). When unset, the BFF
# serves recorded fixtures in-process so the app demos standalone.
# Live gateway path conventions — every path carries the gateway's ROUTE PREFIX, which the
# gateway strips before proxying (ADR-004). One base URL (the gateway) serves all services;
# the prefix is what selects one. Getting this wrong returns 404 from the gateway, not from
# the service.
#   ${AUTH_BASE_URL}/identity/api/v1/auth/*
#   ${COMMERCE_BASE_URL}/catalog/api/v1/catalog_items
#   ${COMMERCE_BASE_URL}/orders/api/v1/orders[/:number]
#   ${PROPERTY_BASE_URL}/property/api/v1/lots[/:id]
#   ${OPERATIONS_BASE_URL}/cases/api/v1/cases[/:number]
# AUTH_BASE_URL=https://gateway.internal
# COMMERCE_BASE_URL=https://gateway.internal
# PROPERTY_BASE_URL=https://gateway.internal
# BILLING_BASE_URL=https://gateway.internal
# HR_BASE_URL=https://gateway.internal
# OPERATIONS_BASE_URL=https://gateway.internal
# REPORTING_BASE_URL=https://gateway.internal
# DOCUMENTS_BASE_URL=https://gateway.internal
# SCHEDULING_BASE_URL=https://gateway.internal   # /scheduling/api/v1/bookings|resources
# AUDIT_BASE_URL=https://gateway.internal         # /audit/api/v1/events
# ACCOUNTING_BASE_URL=https://gateway.internal    # /accounting/api/v1/journal_entries|trial_balance

# --- Public site origin (SEO) -------------------------------------------
# Canonical URLs, sitemap.xml, robots.txt, OpenGraph and the LocalBusiness
# structured data are built from this origin (lib/seo.ts). SERVER-SIDE only —
# never NEXT_PUBLIC_* (metadata is rendered on the server). Unset uses the
# documented deployment host: https://in-memoriam.edgepoint-ai.com
# SITE_URL=https://villa.example.ph

# Persona quick-fill hints on the login screen are VISIBLE by default
# (demo-first). Set to "0" to hide them. Build-time inlined: set before building.
NEXT_PUBLIC_DEMO_HINTS=1

# LOCAL-DEV ONLY password for the persona buttons. NEXT_PUBLIC_* is inlined into public
# JavaScript at build time, so never set this on a deployed build — it would publish the
# credential. Deployed demos use the server-side DEMO_QUICK_FILL pair below instead.
# Next.js does not read this file: copy it to .env for `npm run dev`.
NEXT_PUBLIC_DEMO_PASSWORD=Demo-Passw0rd!

# Server-side demo quick-fill — NOT inlined into public JS. It is read per request and
# delivered only in that response, so a deployed demo can have one-click persona fill
# without publishing credentials in the site's JavaScript. Set DEMO_QUICK_FILL=1 to make
# the persona buttons on /login, /client/login and /agent/login fill the password as well
# as the email; unset (or any value but "1") keeps today's email-only fill. Password
# source, in order:
#   1. DEMO_QUICK_FILL_PASSWORD when set — required whenever AUTH_BASE_URL is configured
#      (e.g. the docker compose stub-gateway stack, or a demo box's per-deployment seed).
#   2. the dev seed in lib/fixtures/auth/personas.json, but only in fixture mode (no
#      AUTH_BASE_URL). A configured gateway never receives the repo seed.
# When enabled, the password is disclosed to anyone loading the sign-in page — demo
# deployments only.
# DEMO_QUICK_FILL=1
# DEMO_QUICK_FILL_PASSWORD=Demo-Passw0rd!

# Set to "1" to force Secure cookie attribute (use behind TLS).
SECURE_COOKIES=0

# Port for standalone SSR container runs (compose/VM profile). Defaults 4000
# (keeps :3000 free for platform/other local projects; `npm run dev` also uses 4000).
PORT=4000
