# ============================================================================
# PRODUCTION ENVIRONMENT — copy to `.env.production` and fill in, then run:
#   docker compose --env-file .env.production -f docker-compose.production.yml up -d --build
#
# This file is the deployer's checklist. `.env.production` is gitignored (never
# commit real values; this example carries none). Full recipe and verification:
# docs/08-delivery/deploying-web.md
#
# WHAT THIS PROFILE GUARANTEES (pinned in docker-compose.production.yml, not here):
#   · demo quick-fill OFF — no DEMO_QUICK_FILL / DEMO_QUICK_FILL_PASSWORD exist here;
#   · no published demo password — the image build refuses NEXT_PUBLIC_DEMO_PASSWORD;
#   · SECURE_COOKIES=1 — session cookies are HTTPS-only (put TLS in front!);
#   · NEXT_PUBLIC_DEMO_HINTS=0 at build time — no persona chips on sign-in screens.
# Do not add NEXT_PUBLIC_* or DEMO_* variables to a production environment file.
# ============================================================================

# --- Required ---------------------------------------------------------------
# Canonical public origin. Feeds canonical URLs, sitemap.xml, robots.txt,
# OpenGraph/Twitter cards and the LocalBusiness structured data (lib/seo.ts).
# No trailing slash. The compose file refuses to start without it.
SITE_URL=https://staging.example.ph

# Host port the container is published on (container always listens on 3000).
# Use 3000 when this host serves only the frontend; pick another when the
# platform's own services already hold 3000.
WEB_PORT=3000

# --- Service base URLs (the edge gateway) -----------------------------------
# The frontend's server side (BFF) calls services through the edge gateway; the
# gateway routes by path prefix (ADR-004). One base URL serves all services.
# Practical recipes:
#   platform box beside the services → http://gateway.internal or http://127.0.0.1:8080
#   standalone staging host          → https://gateway.staging.example.ph
#
# Each URL is OPTIONAL and the default is FIXTURES: leave a line commented out
# and that surface serves recorded contract data (honestly labelled in the UI).
# Set a URL only once that service actually answers — a wrong URL turns those
# screens into upstream 502s rather than demos.
#
# Frozen contracts that CAN go live today:
#   AUTH_BASE_URL       → identity-access  (sign-in, sessions, refresh)
#   COMMERCE_BASE_URL   → catalog-pricing + commerce-ordering (catalogue, orders)
#   PROPERTY_BASE_URL   → property         (lots, reservations)
#   OPERATIONS_BASE_URL → case-events      (cases, stage moves, tasks)
#   BILLING_BASE_URL    → billing          (invoices, payment recording)
#   SCHEDULING_BASE_URL → booking-events   (chapel schedule/bookings)
#   DOCUMENTS_BASE_URL  → documents        (generated documents)
#   AUDIT_BASE_URL      → audit            (audit log)
# AUTH_BASE_URL=https://gateway.example.ph
# COMMERCE_BASE_URL=https://gateway.example.ph
# PROPERTY_BASE_URL=https://gateway.example.ph
# OPERATIONS_BASE_URL=https://gateway.example.ph
# BILLING_BASE_URL=https://gateway.example.ph
# SCHEDULING_BASE_URL=https://gateway.example.ph
# DOCUMENTS_BASE_URL=https://gateway.example.ph
# AUDIT_BASE_URL=https://gateway.example.ph
#
# NOT set, on purpose — these services/contracts do not exist yet:
#   HR_BASE_URL      live reads refuse with a named 503 (no hr contract)
#   CRM_BASE_URL     live reads refuse with a named 503 (no crm contract)
#   REPORTING_/ACCOUNTING_BASE_URL  no client reads them yet
#   Family portal, agent portal, memorials, platform screens, commission:
#   fixture-only by design (the live switches return false), so no env turns
#   them live. See docs/08-delivery/notes/demo-web-route-coverage.md.

# --- Deliberately not in this file -------------------------------------------
# PORT / NODE_ENV / NEXT_TELEMETRY_DISABLED   set by the image and compose
# *_STORE_PATH                                fixture-store journal overrides;
#   only needed if you mount a host directory at /app/.data instead of using the
#   named volume from docker-compose.production.yml
